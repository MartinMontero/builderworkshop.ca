# ---------------------------------------------------------------------------
# Open data (CC BY 4.0). These files are published for reuse, so they must be
# readable cross-origin — without this header a browser fetches them and then
# refuses to hand the response to the page, which is silent from the server's
# side and looks like a client bug. LUME's city-mode venue picker reads
# ecosystem.json directly from the browser.
# ---------------------------------------------------------------------------
/ecosystem.json
  Access-Control-Allow-Origin: *

/ecosystem.geojson
  Access-Control-Allow-Origin: *
